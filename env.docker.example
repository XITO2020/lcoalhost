# Lcoalhost — variables du compose, KVM2 Hostinger (decision Naim 23/09).
# Sur le serveur : /docker/lcoalhost/.env (cree tout seul au 1er deploy-kvm2.bat a partir de ce modele).
# JAMAIS commite, JAMAIS envoye depuis le PC. Remplacer TOUS les CHANGE_ME (le deploiement refuse sinon).
POSTGRES_PASSWORD=CHANGE_ME_long_et_aleatoire
# Mode admin (bureau d'embauche -> Contremaitre) : longue chaine aleatoire, JAMAIS le 123456 du dev
# (le backend refuse de demarrer avec un token faible). Generer par ex. : openssl rand -hex 24
ADMIN_TOKEN=CHANGE_ME_long_et_aleatoire
SITE_ORIGIN=https://lcoalhost.lol
# Plafond disque des copies (big cleaning) : KVM2 partage, doit rester leger -> 5 Go.
STORAGE_BUDGET_MB=5120
# Reddit : vide = connecteur OFF (voir CONNECTEURS.md)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:lcoalhost:0.1
# Paiements (Hacks + encarts Annoncer) : vide = rail Stripe OFF. Compte SASU TabascoCity, PAS ENCORE LIVE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_PAYMENTS=
# Agent memes : OFF. Plus tard : Ollama deja sur le KVM2 (celui de tuveuxun, a muscler), via host.docker.internal.
AGENT_MEMES_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
