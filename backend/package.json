{
  "name": "lcoalhost-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lcoalhost — backend leger : flux scrape (memes, videos, articles dev/tech/IA), reactions, classeur, telechargement",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "scrape": "ts-node --transpile-only src/scraper/run-once.ts",
    "connectors": "ts-node --transpile-only src/scraper/status.ts",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "tiktok:add": "ts-node --transpile-only src/tiktok/add-clip.ts",
    "watch:import": "ts-node --transpile-only src/watch/import-dump.ts",
    "watch:import-json": "ts-node --transpile-only src/watch/import-json.ts",
    "promo:stats": "ts-node --transpile-only src/promo/stats.ts",
    "dev:import-local-videos": "ts-node --transpile-only src/dev/import-local-videos.ts",
    "dev:clear-local-videos": "ts-node --transpile-only src/dev/clear-local-videos.ts",
    "agent:memes": "ts-node --transpile-only src/agents/run-once.ts",
    "agent:review": "ts-node --transpile-only src/agents/review.ts",
    "agent:publish": "ts-node --transpile-only src/agents/publish.ts",
    "agent:reject": "ts-node --transpile-only src/agents/reject.ts",
    "coal:review": "ts-node --transpile-only src/coal/review.ts",
    "quotes:review": "ts-node --transpile-only src/quote/review.ts",
    "coal:approve": "ts-node --transpile-only src/coal/approve.ts",
    "coal:reject": "ts-node --transpile-only src/coal/reject.ts",
    "liquid:review": "ts-node --transpile-only src/liquid/review.ts",
    "liquid:approve": "ts-node --transpile-only src/liquid/approve.ts",
    "liquid:reject": "ts-node --transpile-only src/liquid/reject.ts",
    "ads:review": "ts-node --transpile-only src/ads/review.ts",
    "ads:approve": "ts-node --transpile-only src/ads/approve.ts",
    "ads:reject": "ts-node --transpile-only src/ads/reject.ts",
    "ads:expire": "ts-node --transpile-only src/ads/expire.ts",
    "test": "ts-node --transpile-only src/scraper/topics.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.11",
    "prisma": "^6.14.0",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.2",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
