# Lcoalhost backend — copier en .env (JAMAIS commite).

NODE_ENV=development
PORT=4200
# Origines autorisees (front Vite en dev, domaine en prod)
CORS_ORIGINS=http://localhost:5180,http://localhost:4180
# Base dediee `lcoalhost` (Postgres local en dev)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/lcoalhost

# --- Scraping live ---
SCRAPE_ENABLED=true
SCRAPE_INTERVAL_MIN=30
# Jours de conservation des items scrapes sans reaction ni classement
RETENTION_DAYS=45

# --- Reddit (memes + videos). DESACTIVE tant que ces 3 valeurs sont vides. ---
# Acces .json anonyme ferme depuis mai 2026 ; nouveau client OAuth = approbation manuelle Reddit
# (Responsible Builder Policy). Usage commercial = accord ecrit + facturation a l'appel.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:lcoalhost:0.1 (by /u/CHANGE_ME)
REDDIT_SUBREDDITS=ProgrammerHumor,linuxmemes,softwaregore,ProgrammingHumor,webdev
# Recherche site-wide (hors subs ci-dessus) : chope le sujet viral du moment (ex. "prompt pourri de vibecoding")
REDDIT_SEARCH_QUERIES=vibecoding,vibe coding fail,localhost meme,css meme,ai wrote this code

# --- Paiements (Hacks) : compte Stripe SASU TabascoCity, PAS ENCORE LIVE (KYC en cours). ---
# Vide = rail Stripe OFF (route /api/hacks/checkout renvoie rail_indisponible). Mettre une cle sk_test_...
# pour tester en mode Test Stripe (voir CLAUDE.md pour la procedure "stripe listen").
PAYMENTS_SITE_ID=lcoalhost
PAYMENTS_PUBLIC_URL=http://localhost:5180
PAYMENTS_ENABLED_RAILS=stripe
PAYMENTS_INTENT_TTL_MIN=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_PAYMENTS=

# --- Agent memes (22/09) : Ollama LOCAL uniquement, jamais d'API payante. Ecrit en HIDDEN, relecture obligatoire
# (npm run agent:review / agent:publish / agent:reject). URL par defaut = ta machine de dev ; en prod, pointer
# vers l'Ollama qui tournera SUR le meme serveur (voir CLAUDE.md, decision d'archi a prendre avec Naim).
AGENT_MEMES_ENABLED=true
AGENT_MEMES_PER_CYCLE=1
AGENT_MEMES_MAX_PENDING=20
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Add Coal (23/09) : un LIEN juge pertinent par Qwen est-il publie tout de suite a l'endroit choisi par Qwen ?
# false = Qwen classe, Naim valide (npm run coal:review / coal:approve) ; true = publication directe sans relecture.
COAL_AUTO_PUBLISH=false

# --- Mode admin (22/09) : secret partage (PAS un compte) pour supprimer memes/videos/articles depuis le feed.
# Vide = routes admin toujours refusees (403). Mets une chaine aleatoire, active-la une fois via ?admin=<token>
# dans l'URL du site (le token est ensuite garde en localStorage). A definir aussi en prod, jamais commite.
ADMIN_TOKEN=

# --- Import local de test (23/09) : dossier de vraies videos (sous-dossiers tech) pour juger l'affichage des
# cartes VIDEO sans rien scraper. Vide = desactive, jamais actif en prod. Chemin propre a chaque machine de dev.
LOCAL_VIDEOS_DIR=

# --- Demande de devis pub (24/09) : formulaire "votre encart pub ici" -> email vers tabascocity@proton.me.
# SMTP nodemailer (memes noms de variables que conspix/tbcity). Vide (EMAIL_SERVER_HOST non renseigne) = la demande
# est seulement stockee en base (npm run quotes:review), aucun envoi.
#
# RELAIS RECOMMANDE = Brevo (FR-EU, aligne anti-Big-Tech, palier gratuit ~300 mails/j — a reconfirmer a l'inscription) :
#   EMAIL_SERVER_HOST=smtp-relay.brevo.com
#   EMAIL_SERVER_PORT=587                      (STARTTLS ; le code deduit secure=false du port)
#   EMAIL_SERVER_USER=<email de connexion du compte Brevo>
#   EMAIL_SERVER_PASSWORD=<cle SMTP generee dans Brevo : Parametres > SMTP & API > cles SMTP, PAS le mot de passe du compte>
#   EMAIL_FROM=<un expediteur VALIDE dans Brevo> (ex: anon@lcoal.host une fois le domaine lcoal.host verifie cote Brevo)
#
# NE PAS melanger un host et un user d'operateurs differents : smtp.mailgun.org exige un login Mailgun
# (postmaster@mg.<domaine>), PAS une adresse @proton.me ; Proton exige smtp.protonmail.com + un token Bridge payant.
# Le couple mailgun+proton n'authentifie nulle part (c'est pour ca que rien ne partait).
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=anon@lcoal.host
QUOTE_TO_EMAIL=tabascocity@proton.me
